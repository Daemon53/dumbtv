<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.dumbtv.weather">

    <!-- The one permission, and the reason this is its own app: dumbtv home stays offline and
         reads the forecast from here. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Answers dumbtv home only; Provider.call checks the caller's package. -->
        <provider
            android:name=".Provider"
            android:authorities="tv.dumbtv.weather"
            android:exported="true" />
    </application>
</manifest>
